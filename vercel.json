{
  "version": 2,
  "builds": [
    {
      "src": "bot/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/bot/index.html"
    },
    {
      "src": "/static/(.*)",
      "dest": "/bot/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/bot/$1"
    }
  ]
}